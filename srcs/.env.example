# cp srcs/.env.example srcs/.env — aucune valeur reelle dans ce fichier versionne.
# Les identifiants Postgres sont des secrets Docker dans secrets/, crees par `make`.

# --- Base de donnees ---
POSTGRES_DB=pgdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL complete (hebergeur) : prioritaire sur les POSTGRES_*, laisser vide en local
DATABASE_URL=
SQL_ECHO=false

# --- Application ---
# Obligatoire, 32 caracteres minimum : openssl rand -hex 32
SECRET_KEY=
# Obligatoire, cle Fernet (44 caracteres) :
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=
# dev | prod
ENVIRONMENT=dev
# Hote servi par nginx. Pour jouer en reseau local, mettre l'IP de la machine
# ici et dans ALLOWED_ORIGINS, puis ouvrir https://<ip>:8443
SERVER_NAME=localhost
PUBLIC_URL=https://localhost:8443
ALLOWED_ORIGINS=https://localhost:8443

# --- Durees de vie (secondes) ---
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
MFA_TOKEN_TTL=300

# Charge les exercices au demarrage : a laisser a true
SEED_DEMO_DATA=true

# --- Correcteur LLM (Ollama via Tailscale) ---
# Necessite aussi secrets/TS_AUTHKEY ; sinon l'eleve s'auto-evalue
LLM_ENABLED=false
LLM_BASE_URL=http://<ip-tailscale-de-la-machine>:11434
LLM_MODEL=gemma4:12b
LLM_PROXY_URL=http://tailscale:1055
LLM_TIMEOUT=60
LLM_HOURLY_TOKEN_BUDGET=200000
LLM_ATTEMPTS_PER_QUESTION=3

# --- OAuth 2.0 (optionnel, vide = fournisseur desactive) ---
# URL de retour : <PUBLIC_URL>/api/v1/auth/oauth/<google|github|fortytwo>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
